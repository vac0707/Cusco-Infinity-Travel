rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny catch-all rule
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email_verified == true
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Packages (Tours)
    match /packages/{packageId} {
      // Public read for all travelers
      allow read: if true;
      // Only authenticated admins can create, update, or delete tours
      allow create, update, delete: if isAdmin() && isValidId(packageId);
    }

    // Destinations
    match /destinations/{destinationId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() && isValidId(destinationId);
    }

    // Testimonials
    match /testimonials/{testimonialId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() && isValidId(testimonialId);
    }

    // Site Settings (contact, policies, hero)
    match /site_settings/{settingId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() && isValidId(settingId);
    }

    // Admins list
    match /admins/{adminId} {
      allow read: if isSignedIn() && request.auth.uid == adminId;
      allow write: if isAdmin();
    }
  }
}
